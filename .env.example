# Sao chép thành .env (cùng thư mục với scrapy.cfg). Trên Crawlab, khai báo các biến này
# trong phần Environment của spider. KHÔNG commit file .env và file SSL.

# ===================== Kafka =====================
# Cách gửi: broker = kết nối thẳng Kafka (Hydra); http = qua API publish-message (Kafka dev)
KAFKA_MODE=broker

KAFKA_TOPIC_INPUT=hydra-profile-scheduler-chotot
KAFKA_TOPIC_OUTPUT=hydra-chotot
KAFKA_TOPIC_LOG=hydra-spider-log
# Gửi log [HYDRA-MONITOR] lên KAFKA_TOPIC_LOG (test trên Kafka dev nên đặt false)
KAFKA_LOGGING_ENABLED=true

# ----- Chỉ dùng khi KAFKA_MODE=http -----
KAFKA_HTTP_URL=
KAFKA_HTTP_API_KEY=
# Số message gom vào 1 request
KAFKA_HTTP_BATCH_SIZE=50
# Giây chờ API phản hồi
KAFKA_HTTP_TIMEOUT=30
KAFKA_HTTP_VERIFY_SSL=true

# ----- Chỉ dùng khi KAFKA_MODE=broker -----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Hydra dùng SSL (đặt 3 file chứng chỉ trong chotot/ssl/); không SSL thì đặt PLAINTEXT
KAFKA_SECURITY_PROTOCOL=SSL
KAFKA_SSL_CAFILE=chotot/ssl/ca.pem
KAFKA_SSL_KEYFILE=chotot/ssl/key.pem
KAFKA_SSL_CERTFILE=chotot/ssl/certificate.pem
KAFKA_SSL_CHECK_HOSTNAME=false
# Spider mẫu dùng 1.0.0; để trống thì tự dò
KAFKA_API_VERSION=
# Đọc topic input
KAFKA_GROUP_ID=group-chotot
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_POLL_TIMEOUT_MS=50000
KAFKA_POLL_MAX_RECORDS=500

# ===================== Redis (chống trùng) =====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===================== Elasticsearch / API profile (để trống thì bỏ qua) =====================
ES_HOST=
ES_INDEX_CRAWLED_TIME=hydra-profiles
END_POINT_API=
API_KEY_GLOBAL=
HYDRA_CRAWLER_SYSTEM=api-crawler

# ===================== API lấy số điện thoại đầy đủ =====================
# false = không gọi API, seller.phone = null. Đi qua proxy giống crawl web (USE_PROXY / CRAWL_PROXY)
PHONE_API_ENABLED=true
PHONE_API_URL=https://gateway.chotot.com/v1/private/ad-listing/phone
# API lấy Bearer token cho API phone (GET, gửi header X-Session-Keeper-Key), đi qua proxy giống crawl.
# Lúc khởi động không lấy được token thì spider dừng và báo lỗi
PHONE_TOKEN_API_URL=
# Giá trị header X-Session-Keeper-Key (KHÔNG commit)
PHONE_TOKEN_API_KEY=
# Token hết hạn (quá exp hoặc API phone trả 401/403): tạm dừng spider, đợi PHONE_TOKEN_RETRY_DELAY giây
# rồi lấy token mới, thử tối đa PHONE_TOKEN_MAX_RETRIES lần; vẫn không được thì dừng spider
PHONE_TOKEN_RETRY_DELAY=60
PHONE_TOKEN_MAX_RETRIES=3
# Giây chờ API phản hồi
PHONE_API_TIMEOUT=15
# Tốc độ gọi API (tách riêng với crawl web): giây nghỉ giữa 2 lần gọi, số request song song.
# AutoThrottle có thể tự tăng delay khi API phản hồi chậm
PHONE_API_DELAY=1.5
PHONE_API_CONCURRENCY=2
# Lưu số đã lấy trong Redis bao nhiêu giờ để không gọi API lại, 0 = không cache
PHONE_CACHE_TTL_HOURS=168

# ===================== Crawl =====================
USE_PROXY=false
CRAWL_PROXY=
CHOTOT_START_URL=https://www.chotot.com/mua-ban
# Số trang danh sách tối đa
CHOTOT_MAX_PAGES=5
# Số tin tối đa mỗi trang, 0 = lấy hết
CHOTOT_MAX_ITEMS_PER_PAGE=0
# Dừng sau N tin hợp lệ, 0 = không giới hạn
TARGET_ITEM_COUNT=0
# Tốc độ crawl: giây nghỉ giữa 2 request, số request song song (tổng / mỗi domain)
DOWNLOAD_DELAY=1.5
CONCURRENT_REQUESTS=8
CONCURRENT_REQUESTS_PER_DOMAIN=4

# ===================== Log =====================
LOG_LEVEL=INFO
# Ghi log ra logs/ và bảng tổng kết cuối lượt chạy
MONITOR_ENABLED=true
# In tiến độ sau mỗi N tin
MONITOR_PROGRESS_EVERY=50
