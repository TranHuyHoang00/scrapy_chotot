# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== Kafka =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=chotot.ads

# ===== Crawl =====
# Bật proxy khi crawl: true / false
USE_PROXY=true
CRAWL_PROXY=http://17x.2x.14x.4x:3x2x

# Số item hợp lệ cần thu thập rồi dừng
TARGET_ITEM_COUNT=10

# Tốc độ crawl (giây nghỉ giữa các request, số request song song)
DOWNLOAD_DELAY=2
CONCURRENT_REQUESTS=8

# ===== Log =====
LOG_LEVEL=INFO