# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== Kafka =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=hb1014.companies

# ===== Crawl =====
# Bật proxy khi crawl: true / false
USE_PROXY=false
CRAWL_PROXY=http://172.20.148.40:3128

# Số item hợp lệ cần thu thập rồi dừng
TARGET_ITEM_COUNT=1000

# Tốc độ crawl (giây nghỉ giữa các request, số request song song)
DOWNLOAD_DELAY=1
CONCURRENT_REQUESTS=8

# ===== Log =====
LOG_LEVEL=INFO